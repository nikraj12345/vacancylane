# Copy to .env and fill in at least one Google search provider + OAuth client.

# Preferred: Serper returns real Google organic results as JSON.
# Sign up at https://serper.dev — 2,500 free queries, no credit card.
SERPER_API_KEY=

# Optional fallback: Google Programmable Search (Custom Search JSON API).
# Free tier is 100 queries/day. Needs both values.
# https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Postgres (Docker container mapped to host port 5434).
DATABASE_URL=postgresql+psycopg://shyftos-rbac:shyftos@127.0.0.1:5434/vacancylane

# Google Sign-In — create an OAuth 2.0 Web client in Google Cloud Console,
# add http://localhost:3000 to Authorized JavaScript origins, then paste the
# client ID here (and as NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend).
GOOGLE_OAUTH_CLIENT_ID=

# Random secret used to sign Vacancylane session JWTs after Google login.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=336
